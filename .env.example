# MYTHOS — plantilla de variables públicas (versionada, sin valores reales).
#
# Todas las variables PUBLIC_* se integran en el HTML generado: son públicas y NUNCA deben contener
# secretos. En Vercel los valores se configuran en la plataforma (Preview → staging, Production →
# production). Para simular producción en local, copia este archivo a .env.production.local (ignorado
# por Git) y ajusta los valores. Contrato completo: docs/deployment_strategy.md §3–4.

# Ambiente lógico: development | staging | production. Con VERCEL_ENV=preview debe ser staging;
# con VERCEL_ENV=production, production.
PUBLIC_APP_ENV=production

# Origen público absoluto, sin ruta ni barra adicional. En builds remotos exige HTTPS y rechaza hosts
# locales y dominios reservados (.invalid, .example, .test, example.com…).
PUBLIC_SITE_URL=https://dominio-aprobado.example.invalid

# Experimentos 3D adicionales; los dos visores del MVP no dependen de ella. Exactamente true o false.
PUBLIC_ENABLE_EXPERIMENTAL_3D=false
