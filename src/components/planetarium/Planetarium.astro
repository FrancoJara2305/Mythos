---
/**
 * Planetario de Constelaciones (GR-04, The Dodekatheon): la bóveda celeste donde cada deidad es una
 * constelación que dibuja su símbolo, en lugar de una grilla de tarjetas.
 *
 * Mejora progresiva estricta. El HTML del build contiene todo: cada constelación con su figura (SVG
 * estático) y sus cuatro facetas —quién es y su origen, sus grandes relatos, dominios y símbolos,
 * secretos de su nombre—, y la explicación de las dos tradiciones (Hestia / Dioniso) con el relieve
 * Walters 23.40. Con JavaScript y WebGL, `<mythos-planetarium>` (planetarium.ts) convierte esa lista
 * en el panel narrativo de una escena 3D navegable; los datos mínimos de la escena viajan en JSON.
 */
import { Picture } from 'astro:assets';
import StoryBody from '../narrative/StoryBody.astro';
import MixedText from '../ui/MixedText.astro';
import { profileIds, type Chapter, type ChapterSelection } from '../../config/chapters.ts';
import { isPublished } from '../../config/navigation.ts';
import { loadArchive } from '../../lib/content/archive.ts';
import { serializeForScript } from '../../lib/genealogy/build-data.ts';
import { imageAt } from '../../lib/media.ts';
import {
  CONSTELLATION_ANCHOR_PREFIX,
  constellationSvg,
  FACET_LABELS,
  planetariumData,
  seatOf,
  STAR_FACETS,
  traditionOf,
} from '../../lib/planetarium/model.ts';
import { paths } from '../../lib/routes.ts';

interface Props {
  chapter: Chapter;
  selection: ChapterSelection;
  hook: string;
}

const { chapter, selection, hook } = Astro.props;
const { visible } = await loadArchive();
const data = planetariumData(visible, selection);
const deities = new Map(visible.deities.map((entry) => [entry.id, entry.data]));

const cards = profileIds(selection).flatMap((id) => {
  const deity = deities.get(id);
  const sky = data.deities[id];
  if (deity === undefined || sky === undefined) return [];
  const sections = (kinds: readonly string[]) => deity.storySections.filter((section) => section.kind !== undefined && kinds.includes(section.kind));
  return [
    {
      id,
      deity,
      sky,
      seat: seatOf(data, id) + 1,
      tradition: traditionOf(data, id),
      figure: constellationSvg(sky),
      origin: sections(['origin', 'character']),
      deeds: sections(['deeds']),
      symbolism: sections(['symbolism']),
      names: deity.didacticNotes.filter((note) => note.kind === 'name' || note.kind === 'concept'),
      myths: visible.myths.filter((myth) => myth.data.chapterIds.includes(selection.chapterId) && myth.data.participants.some((participant) => participant.id === id)),
    },
  ];
});

// Las dos tradiciones: solo si la otra divinidad y el objeto que la respalda son visibles.
const alternative = selection.alternatives[0];
const evidence = visible.artifacts.find((artifact) => artifact.id === alternative?.evidenceArtifactId);
const evidenceImage = evidence?.data.media.find((media) => media.type === 'image');
const mainDeity = alternative === undefined ? undefined : deities.get(alternative.without);
const altDeity = alternative === undefined ? undefined : deities.get(alternative.with);
const hasTraditions = data.traditions !== undefined && alternative !== undefined && mainDeity !== undefined && altDeity !== undefined;
const procession = (evidence?.data.identifications ?? []).map((identification) => ({
  id: identification.entity.id,
  name: deities.get(identification.entity.id)?.name ?? identification.entity.id,
  href: deities.get(identification.entity.id)?.profile === 'full' ? paths.deity(identification.entity.id) : undefined,
}));
const rooms = [
  { href: paths.genealogy(selection.chapterId), label: 'Mapa de Linajes Estelares', text: 'quién es hijo de quién, y qué cuentan las distintas tradiciones' },
  { href: paths.atlas(selection.chapterId), label: 'Hilo del Destino', text: 'la saga completa, episodio a episodio' },
].filter((room) => isPublished(room.href));
---

<mythos-planetarium class="planetarium" data-state="static" data-tradition="main">
  <div class="planetarium__sky" aria-hidden="true">
    <canvas class="planetarium__canvas" data-canvas></canvas>
    <div class="planetarium__layer" data-labels></div>
    <div class="planetarium__layer" data-nodes></div>
  </div>

  <header class="planetarium__head">
    <p class="eyebrow">{chapter.number} · Bóveda olímpica</p>
    <h1 class="planetarium__title" lang={chapter.titleLang}>{chapter.title}</h1>
    <p class="planetarium__subtitle">Los doce olímpicos</p>
    <p class="planetarium__hook">{hook}</p>
    <p class="planetarium__help" data-help>
      Cada dios es una constelación que dibuja su símbolo. Elige una para viajar hasta ella; sus estrellas más brillantes guardan su
      historia.
      <span class="planetarium__drag">Arrastra el cielo para girar la bóveda y descubrir las demás.</span>
    </p>
  </header>

  <div class="planetarium__controls" data-controls hidden>
    {
      hasTraditions && data.traditions !== undefined && (
        <div class="tradition">
          <div class="tradition__switch" role="group" aria-label="Tradición de los doce">
            <button type="button" class="tradition__option" data-tradition="alt" aria-pressed="false">
              {data.traditions.alt}
            </button>
            <span class="tradition__arrow" aria-hidden="true">↔</span>
            <button type="button" class="tradition__option" data-tradition="main" aria-pressed="true">
              {data.traditions.main}
            </button>
          </div>
          <p class="tradition__note" data-tradition-note="main">
            En esta tradición, el duodécimo asiento es de {mainDeity?.name}.{' '}
            <button type="button" class="tradition__why" data-why-open>
              ¿Por qué cambia la lista?
            </button>
          </p>
          <p class="tradition__note" data-tradition-note="alt" hidden>
            En esta tradición, el duodécimo asiento es de {altDeity?.name}.{' '}
            <button type="button" class="tradition__why" data-why-open>
              ¿Por qué cambia la lista?
            </button>
          </p>
        </div>
      )
    }

    <div class="travel">
      <button type="button" class="travel__step" data-prev>
        <span aria-hidden="true">←</span>
        <span class="travel__text">Constelación anterior</span>
      </button>
      <p class="travel__current">
        <span class="visually-hidden">Ahora: </span>
        <span data-current>Vista general</span>
      </p>
      <button type="button" class="travel__step travel__step--next" data-next>
        <span class="travel__text">Siguiente constelación</span>
        <span aria-hidden="true">→</span>
      </button>
      <button type="button" class="travel__overview" data-overview disabled>Ver toda la bóveda</button>
    </div>

    <nav class="orbit" aria-label="Selector orbital de constelaciones">
      <ol class="orbit__list" role="list">
        {
          cards.map((card) => (
            <li>
              <button
                type="button"
                class="orbit__star"
                data-seat-button={card.id}
                aria-pressed="false"
                hidden={card.tradition === 'alt'}
                style={`--star: ${card.sky.color}`}
              >
                <span class="orbit__dot" aria-hidden="true" />
                <span class="orbit__name">{card.deity.name}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>
    <p class="visually-hidden" role="status" data-status></p>
  </div>

  <div class="planetarium__roster" data-roster>
    <h2 class="planetarium__roster-title">Las constelaciones de los Doce</h2>
    <ol class="planetarium__cards" role="list">
      {
        cards.map((card) => (
          <li class="sky-card" id={`${CONSTELLATION_ANCHOR_PREFIX}${card.id}`} data-card={card.id} data-view="intro" style={`--star: ${card.sky.color}`}>
            <header class="sky-card__head">
              <div class="sky-card__figure" set:html={card.figure} />
              <div class="sky-card__identity">
                <p class="sky-card__shape">
                  Constelación {card.seat} de 12 · {card.sky.shape}
                  {card.tradition === 'alt' && data.traditions !== undefined && <span class="sky-card__tradition"> · {data.traditions.alt}</span>}
                  {card.tradition === 'main' && data.traditions !== undefined && <span class="sky-card__tradition"> · {data.traditions.main}</span>}
                </p>
                <h3 class="sky-card__name">
                  <a href={paths.deity(card.id)}>{card.deity.name}</a>
                </h3>
                {card.deity.greekName !== undefined && (
                  <p class="sky-card__greek">
                    <span lang="grc">{card.deity.greekName}</span>
                    {card.deity.transliteration !== undefined && <i>{card.deity.transliteration}</i>}
                  </p>
                )}
                {card.deity.tagline !== undefined && <p class="sky-card__tagline">{card.deity.tagline}</p>}
              </div>
              <button type="button" class="sky-card__close" data-close>
                <span aria-hidden="true">×</span>
                <span class="visually-hidden">Cerrar y ver toda la bóveda</span>
              </button>
            </header>

            <div class="sky-card__tabs" role="group" aria-label={`Estrellas de ${card.deity.name}`}>
              {STAR_FACETS.map((facet, index) => (
                <button type="button" class="sky-card__tab" data-facet-tab={facet} aria-pressed="false">
                  <span class="sky-card__tab-number" aria-hidden="true">
                    {index + 1}
                  </span>
                  {FACET_LABELS[facet]}
                </button>
              ))}
            </div>

            <section class="facet" data-facet="origin" aria-labelledby={`${card.id}-origin`}>
              <h4 id={`${card.id}-origin`} class="facet__title">
                {FACET_LABELS.origin}
              </h4>
              {card.deity.narrativeHook !== undefined && (
                <p class="facet__lede">
                  <MixedText text={card.deity.narrativeHook} />
                </p>
              )}
              {card.origin.map((section) => (
                <div class="facet__block">
                  <h5 class="facet__heading">
                    <MixedText text={section.heading} />
                  </h5>
                  <StoryBody body={section.body} />
                </div>
              ))}
            </section>

            <section class="facet" data-facet="tales" aria-labelledby={`${card.id}-tales`}>
              <h4 id={`${card.id}-tales`} class="facet__title">
                {FACET_LABELS.tales}
              </h4>
              {card.deeds.map((section) => (
                <div class="facet__block">
                  <h5 class="facet__heading">
                    <MixedText text={section.heading} />
                  </h5>
                  <StoryBody body={section.body} />
                </div>
              ))}
              {card.myths.length > 0 && (
                <div class="facet__block">
                  <h5 class="facet__heading">Relatos para seguir leyendo</h5>
                  <ul class="facet__myths" role="list">
                    {card.myths.map((myth) => (
                      <li>
                        <a href={paths.myth(myth.id)}>{myth.data.title}</a>
                        {myth.data.tagline !== undefined && <span> — {myth.data.tagline}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>

            <section class="facet" data-facet="domains" aria-labelledby={`${card.id}-domains`}>
              <h4 id={`${card.id}-domains`} class="facet__title">
                {FACET_LABELS.domains}
              </h4>
              {card.symbolism.map((section) => (
                <div class="facet__block">
                  <h5 class="facet__heading">
                    <MixedText text={section.heading} />
                  </h5>
                  <StoryBody body={section.body} />
                </div>
              ))}
              <dl class="facet__attributes">
                {[...card.deity.domains, ...card.deity.symbols].map((attribute) => (
                  <div>
                    <dt>
                      <MixedText text={attribute.label} />
                    </dt>
                    <dd>
                      <MixedText text={attribute.context} />
                    </dd>
                  </div>
                ))}
              </dl>
            </section>

            <section class="facet" data-facet="names" aria-labelledby={`${card.id}-names`}>
              <h4 id={`${card.id}-names`} class="facet__title">
                {FACET_LABELS.names}
              </h4>
              <ul class="facet__names" role="list">
                {card.names.map((note) => (
                  <li>
                    {note.term !== undefined && (
                      <p class="facet__term" lang="grc">
                        {note.term}
                      </p>
                    )}
                    <h5 class="facet__heading">
                      <MixedText text={note.title} />
                    </h5>
                    <StoryBody body={note.body} />
                  </li>
                ))}
              </ul>
            </section>

            <p class="sky-card__more">
              <a href={paths.deity(card.id)}>
                Leer la historia completa de {card.deity.name}
                <span aria-hidden="true">→</span>
              </a>
            </p>
          </li>
        ))
      }
    </ol>
  </div>

  {
    hasTraditions && alternative !== undefined && data.traditions !== undefined && (
      <section id="dos-tradiciones" class="why" data-why aria-labelledby="dos-tradiciones-titulo">
        <div class="why__inner">
          <p class="eyebrow">Una curiosidad de la bóveda</p>
          <h2 id="dos-tradiciones-titulo" class="why__title">
            ¿Doce dioses… o trece?
          </h2>
          <div class="why__text">
            <p>
              Los griegos hablaban de «los Doce», pero nunca firmaron una lista única. Cada ciudad, cada altar y cada artista
              podía contar hasta doce a su manera. Por eso el duodécimo asiento de esta bóveda tiene dos dueños posibles:
              {' '}
              <strong>{altDeity?.name}</strong>, la diosa del hogar, y <strong>{mainDeity?.name}</strong>, el dios del vino.
            </p>
            {evidence !== undefined && (
              <p>
                Mira este relieve de mármol: doce divinidades caminan en fila. La primera por la izquierda es {altDeity?.name}, con
                su cetro. Cuéntalas todas: {mainDeity?.name} no está.
              </p>
            )}
          </div>

          {evidence !== undefined && evidenceImage !== undefined && evidenceImage.type === 'image' && (
            <figure class="why__figure">
              <div class="why__mat">
                <Picture
                  src={imageAt(evidenceImage.localPath)}
                  formats={['avif', 'webp']}
                  widths={[480, 960, 1440, evidenceImage.width]}
                  sizes="(min-width: 70rem) 60rem, calc(100vw - 3rem)"
                  alt={evidenceImage.alt}
                  loading="lazy"
                />
              </div>
              <figcaption class="why__caption">
                <span>
                  De izquierda a derecha:{' '}
                  {procession.map((figure, index) => (
                    <>
                      {index > 0 && ', '}
                      {figure.href === undefined ? figure.name : <a href={figure.href}>{figure.name}</a>}
                    </>
                  ))}
                  .
                </span>
                <span>
                  Relieve de los doce dioses, {evidence.data.institution}.{' '}
                  <a href={paths.artifact(evidence.id)}>Ver el relieve de cerca</a>
                </span>
              </figcaption>
            </figure>
          )}

          <div class="why__text">
            <p>{alternative.note}</p>
          </div>
          <ul class="why__choices" role="list">
            <li>
              <a href={paths.deity(alternative.with)} data-select={alternative.with}>
                <span class="why__choice-label">{data.traditions.alt}</span>
                <span>{altDeity?.tagline}</span>
              </a>
            </li>
            <li>
              <a href={paths.deity(alternative.without)} data-select={alternative.without}>
                <span class="why__choice-label">{data.traditions.main}</span>
                <span>{mainDeity?.tagline}</span>
              </a>
            </li>
          </ul>
          <p class="why__close">
            <button type="button" data-why-close>
              Volver a la bóveda
            </button>
          </p>
        </div>
      </section>
    )
  }

  {
    rooms.length > 0 && (
      <nav class="planetarium__rooms" aria-label="Otras salas del capítulo">
        <ul role="list">
          {rooms.map((room) => (
            <li>
              <a href={room.href}>{room.label}</a>: {room.text}.
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <script type="application/json" is:inline data-planetarium set:html={serializeForScript(data)} />
</mythos-planetarium>

<script>
  import './planetarium.ts';
</script>

<style>
  /* ——————————————— Común ——————————————— */
  .planetarium {
    position: relative;
    display: grid;
    gap: var(--space-48);
    padding: var(--space-48) var(--gutter) var(--space-32);
  }

  .planetarium__sky {
    display: none;
  }

  .planetarium__head {
    display: grid;
    gap: var(--space-8);
    max-inline-size: 46rem;
  }

  .planetarium__title {
    font-size: clamp(3rem, 1.6rem + 6vw, 7rem);
    font-weight: 500;
    line-height: 0.95;
  }

  .planetarium__subtitle {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-style: italic;
  }

  .planetarium__hook {
    font-size: 1.125rem;
  }

  .planetarium__help {
    font-size: var(--font-size-small);
  }

  .planetarium__roster-title {
    font-size: var(--font-size-h2);
    margin-block-end: var(--space-24);
  }

  .planetarium__cards {
    display: grid;
    gap: var(--space-32);
  }

  /* ——— Tarjeta de constelación (lista sin JS / panel con la bóveda activa) ——— */
  .sky-card {
    display: grid;
    gap: var(--space-24);
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid color-mix(in srgb, var(--star) 40%, transparent);
    border-radius: var(--radius-card);
    background:
      radial-gradient(90% 50% at 100% 0%, color-mix(in srgb, var(--star) 14%, transparent), transparent 70%),
      var(--surface-glass);
    scroll-margin-block-start: var(--anchor-offset);
  }

  .sky-card__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-16);
    align-items: center;
  }

  .sky-card__figure {
    inline-size: clamp(4.5rem, 14vw, 7.5rem);
    aspect-ratio: 1;
    filter: drop-shadow(0 0 0.5rem color-mix(in srgb, var(--star) 60%, transparent));
  }

  .sky-card__figure :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  .sky-card__shape {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sky-card__name {
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
  }

  .sky-card__name a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .sky-card__name a:hover {
    color: var(--star);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .sky-card__greek {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-12);
    align-items: baseline;
    font-size: 1.125rem;
  }

  .sky-card__greek i {
    font-family: var(--font-display);
    font-size: 1.125rem;
  }

  .sky-card__tagline {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-style: italic;
    line-height: 1.25;
  }

  .sky-card__close,
  .sky-card__tabs {
    display: none;
  }

  .facet {
    display: grid;
    gap: var(--space-16);
    align-content: start;
  }

  .facet__title {
    font-family: var(--font-text);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--star);
  }

  .facet__lede {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.35;
  }

  .facet__block,
  .facet__names li {
    display: grid;
    gap: var(--space-8);
    font-size: 1rem;
    line-height: 1.65;
  }

  .facet__heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .facet__myths,
  .facet__names {
    display: grid;
    gap: var(--space-12);
  }

  .facet__myths a,
  .sky-card__more a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-block-size: var(--target-min);
    font-weight: 600;
  }

  .facet__attributes {
    display: grid;
    gap: var(--space-12);
  }

  .facet__attributes div {
    padding-inline-start: var(--space-16);
    border-inline-start: 2px solid color-mix(in srgb, var(--star) 70%, transparent);
  }

  .facet__attributes dt {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
  }

  .facet__attributes dd {
    font-size: var(--font-size-small);
  }

  .facet__term {
    font-size: 1.625rem;
    color: var(--text-link);
  }

  .facet__names li {
    padding: var(--space-16);
    border: 1px solid var(--rule-soft);
    border-radius: 0.875rem;
  }

  /* ——— Las dos tradiciones ——— */
  .why {
    scroll-margin-block-start: var(--anchor-offset);
  }

  .why__inner {
    display: grid;
    gap: var(--space-24);
    max-inline-size: 64rem;
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    border: 1px solid color-mix(in srgb, var(--color-bronze) 60%, transparent);
    border-radius: var(--radius-card);
    background:
      radial-gradient(80% 50% at 50% 0%, rgb(217 119 6 / 0.16), transparent 70%),
      var(--surface-stone);
  }

  .why__title {
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem);
  }

  .why__text {
    display: grid;
    gap: var(--space-12);
    max-inline-size: var(--measure);
  }

  .why__figure {
    display: grid;
    gap: var(--space-12);
  }

  /* Paspartú claro: el fondo blanco de la fotografía se integra con multiply, sin modificar el archivo. */
  .why__mat {
    padding: clamp(var(--space-8), 2vw, var(--space-24));
    border-radius: 0.75rem;
    background-color: var(--color-marble);
  }

  .why__mat :global(img) {
    inline-size: 100%;
    block-size: auto;
    mix-blend-mode: multiply;
  }

  .why__caption {
    display: grid;
    gap: var(--space-4);
    font-size: var(--font-size-small);
  }

  .why__caption a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
  }

  .why__choices {
    display: grid;
    gap: var(--space-16);
  }

  @media (min-width: 48rem) {
    .why__choices {
      grid-template-columns: 1fr 1fr;
    }
  }

  .why__choices a {
    display: grid;
    gap: var(--space-4);
    block-size: 100%;
    padding: var(--space-16) var(--space-24);
    border: 1px solid var(--rule-soft);
    border-radius: 0.875rem;
    color: var(--text-primary);
    text-decoration: none;
