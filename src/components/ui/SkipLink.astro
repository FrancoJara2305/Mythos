---
/** Enlace de salto: primer elemento enfocable; oculto fuera de pantalla hasta recibir foco. */
interface Props {
  href: `#${string}`;
}

const { href } = Astro.props;
---

<a class="skip-link" href={href}>Saltar al contenido</a>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-16);
    inset-inline-start: var(--space-16);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    padding: var(--space-8) var(--space-16);
    background-color: var(--action-primary-bg);
    color: var(--action-primary-text);
    font-size: var(--font-size-control);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(calc(-100% - var(--space-32)));
  }

  .skip-link:focus {
    transform: none;
  }
</style>
