---
/** Página 404 propia. Se genera como dist/404.html; siempre noindex y sin canonical. */
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import { paths } from '../lib/routes.ts';
---

<BaseLayout title="Página no encontrada" description="La dirección solicitada no existe en MYTHOS." noindex>
  <div class="container not-found">
    <p class="not-found__code">Error 404</p>
    <h1>Página no encontrada</h1>
    <p class="prose">
      La dirección solicitada no corresponde a ninguna página publicada del archivo. Puede que el enlace sea
      incorrecto o que la sala aún no esté abierta.
    </p>
    <p>
      <ActionLink href={paths.home()}>Volver al inicio</ActionLink>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-24);
    justify-items: start;
    padding-block: clamp(var(--space-48), 8vw, var(--space-96)) var(--space-32);
  }

  .not-found__code {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
